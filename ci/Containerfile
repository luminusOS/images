# CI toolbox image for lint/test jobs. Rebuilt only when its content hash
# changes — see tools/ci-image-name.py and .github/workflows/ci.yml.
ARG fedora_version
FROM quay.io/fedora/fedora:${fedora_version}

RUN dnf -y install \
      curl \
      findutils \
      gawk \
      git \
      jq \
      just \
      python3 \
      python3-pip \
      python3-pyyaml \
    && dnf clean all && \
    python3 -m venv /opt/images-ci && \
    /opt/images-ci/bin/pip install --no-cache-dir ruff==0.16.2 && \
    ln -s /opt/images-ci/bin/ruff /usr/local/bin/ruff && \
    ruff --version | grep -Fx 'ruff 0.16.2'
