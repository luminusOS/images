#!/usr/bin/env bash
set -ueo pipefail

if [ -e /run/initramfs/live ] || [ -e /dev/mapper/live-base ]; then
  exit 0
fi

mkdir -p /etc/luminusos
printf 'installed\n' > /etc/luminusos/system-mode

rm -f \
  /etc/readymade.toml \
  /etc/xdg/autostart/com.fyralabs.Readymade.desktop \
  /etc/polkit-1/rules.d/49-luminusos-readymade.rules \
  /etc/dconf/db/local \
  /etc/dconf/db/local.d/00-luminusos-live \
  /etc/dconf/profile/user \
  /etc/systemd/user/gnome-session@live-installer.target.wants/luminusos-activate-aurora-shell.service \
  /etc/systemd/user/gnome-session@live-installer.target.wants/luminusos-enable-aurora-shell.service \
  /usr/local/share/applications/com.fyralabs.Readymade.desktop \
  /usr/lib/systemd/user/luminusos-readymade.service \
  /usr/lib/systemd/user/gnome-session@live-installer.target.d/live-installer.session.conf \
  /usr/share/gnome-shell/modes/live-installer.json \
  /usr/share/gnome-session/sessions/live-installer.session \
  /usr/share/wayland-sessions/live-installer.desktop || true

mkdir -p /usr/local/share/applications 2>/dev/null || true
cat > /usr/local/share/applications/com.fyralabs.Readymade.desktop 2>/dev/null <<'EOF' || true
[Desktop Entry]
Type=Application
Name=ReadyMade
Hidden=true
NoDisplay=true
EOF

rm -rf \
  /home/liveuser \
  /var/home/liveuser || true

rm -f \
  /var/lib/AccountsService/users/liveuser \
  /var/lib/AccountsService/icons/liveuser

if [ -f /etc/passwd ]; then
  sed -i '/^liveuser:/d' /etc/passwd
fi
if [ -f /etc/shadow ]; then
  sed -i '/^liveuser:/d' /etc/shadow
fi
if [ -f /etc/group ]; then
  sed -i '/^liveuser:/d; s/,\?liveuser,\?/,/g; s/:,/:/g; s/,$//' /etc/group
fi
if [ -f /etc/gshadow ]; then
  sed -i '/^liveuser:/d; s/,\?liveuser,\?/,/g; s/:,/:/g; s/,$//' /etc/gshadow
fi
if [ -f /etc/subuid ]; then
  sed -i '/^liveuser:/d' /etc/subuid
fi
if [ -f /etc/subgid ]; then
  sed -i '/^liveuser:/d' /etc/subgid
fi
if [ -d /usr/share/glib-2.0/schemas ] && command -v glib-compile-schemas >/dev/null 2>&1; then
  glib-compile-schemas /usr/share/glib-2.0/schemas || true
fi
if command -v dconf >/dev/null 2>&1; then
  dconf update || true
fi

printf 'luminus\n' > /etc/hostname

mkdir -p /etc/gdm
cat > /etc/gdm/custom.conf <<'EOF'
[daemon]
InitialSetupEnable=true
EOF

systemctl disable livesys.service livesys-late.service luminusos-installed-firstboot-cleanup.service >/dev/null 2>&1 || true
