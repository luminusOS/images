#!/usr/bin/env bash
set -euo pipefail

uuid="aurora-shell@luminusos.github.io"
extension_dir="${AURORA_SHELL_EXTENSION_DIR:-/usr/share/gnome-shell/extensions/${uuid}}"

if [ ! -f "${extension_dir}/metadata.json" ]; then
  exit 0
fi

if ! command -v gsettings >/dev/null 2>&1; then
  exit 0
fi

gsettings set org.gnome.shell disable-user-extensions false
gsettings set org.gnome.shell disabled-extensions "@as []"

enabled="$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || printf '@as []')"
case "${enabled}" in
  *"'${uuid}'"*|*"\"${uuid}\""*)
    new_enabled="${enabled}"
    ;;
  "[]"|"@as []")
    new_enabled="['${uuid}']"
    ;;
  *"]")
    new_enabled="${enabled%]}, '${uuid}']"
    ;;
  *)
    new_enabled="['${uuid}']"
    ;;
esac

gsettings set org.gnome.shell enabled-extensions "${new_enabled}"
