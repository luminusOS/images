#!/usr/bin/env bash
set -euo pipefail

# Keep ReadyMade startup logs off the live ISO /var/tmp. Do not use
# /run/readymade-install here: ReadyMade uses that directory internally for
# layered systemd-repart configs and later parses every file in it as UTF-8.
export TMPDIR=/run/readymade-tmp

# /run is volatile, so the directory is created at boot by systemd-tmpfiles.
if [ ! -d "${TMPDIR}" ] || [ ! -w "${TMPDIR}" ]; then
  echo "ReadyMade TMPDIR is not writable: ${TMPDIR}" >&2
  exit 1
fi

# Some ReadyMade backend commands parse process streams as UTF-8. Keep the
# installer environment explicit so localized command output is UTF-8.
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

exec /usr/bin/readymade "$@"
