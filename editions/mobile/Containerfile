ARG core_image=localhost/luminusos-core:latest

# ── Context stage ─────────────────────────────────────────────────────────
FROM scratch AS ctx

COPY common   /common
COPY desktops /desktops

# ── Mobile image ──────────────────────────────────────────────────────────
# Mobile images are flashed directly to device storage — no graphical installer.
# No x86 bootloader stage: mobile devices use device firmware (U-Boot, Qualcomm ABL).
FROM ${core_image}

ARG mobile_desktop=phosh
ARG distro_name="LuminusOS"
ARG distro_pretty_name="Luminus OS"

# Boot packages
RUN --mount=type=cache,target=/var/cache \
    dnf -y install \
      kernel dracut dracut-live \
      mesa-dri-drivers \
      fuse-overlayfs \
    && dnf clean all

# Mobile desktop environment and Flatpaks
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,target=/var/cache \
    env --chdir=/ctx/desktops/${mobile_desktop} ./build && \
    bash /ctx/common/install-flatpaks && \
    /ctx/common/cleanup

# Final cleanup
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/common/cleanup && \
    /ctx/common/finalize

RUN bootc container lint --no-truncate
