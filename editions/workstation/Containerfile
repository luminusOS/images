ARG core_image=localhost/luminusos:latest
ARG fedora_version=44
ARG aurora_shell_version=v50.3

# ── Context stage: shared build scripts ──────────────────────────────────
FROM scratch AS ctx-scripts

COPY shared/scripts /scripts

# ── Context stage: workstation script (stable — changes rarely) ───────────
FROM scratch AS ctx-workstation-script

COPY editions/workstation/build.sh /workstation/build.sh

# ── Context stage: shared Flatpak refs ────────────────────────────────────
FROM scratch AS ctx-flatpaks

COPY shared/flatpaks /flatpaks

# ── Context stage: static files (volatile — changes often) ────────────────
FROM scratch AS ctx-files

COPY editions/workstation/files /workstation/files

# ── Aurora-shell release artifact ─────────────────────────────────────────
FROM quay.io/fedora/fedora-bootc:${fedora_version} AS aurora-extension

ARG fedora_version=44
ARG aurora_shell_version
ARG aurora_shell_sha256
ARG aurora_shell_uuid=aurora-shell@luminusos.github.io

RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    bash /scripts/dnf-releasever.sh "${fedora_version}" && \
    dnf -y --releasever="${fedora_version}" install curl unzip jq && \
    dnf clean all && \
    mkdir -p "/out/${aurora_shell_uuid}" && \
    curl -fsSL \
      "https://github.com/luminusOS/aurora-shell/releases/download/${aurora_shell_version}/${aurora_shell_uuid}.shell-extension.zip" \
      -o /tmp/aurora-shell.zip && \
    # Release tags are mutable; the pinned digest is what actually
    # guarantees we ship the artifact we reviewed.
    echo "${aurora_shell_sha256}  /tmp/aurora-shell.zip" | sha256sum -c - && \
    unzip -q /tmp/aurora-shell.zip -d "/out/${aurora_shell_uuid}" && \
    test -f "/out/${aurora_shell_uuid}/metadata.json" && \
    jq -e --arg uuid "${aurora_shell_uuid}" '.uuid == $uuid' \
      "/out/${aurora_shell_uuid}/metadata.json"

# ── Workstation image (installed desktop payload) ────────────────────────
FROM ${core_image}

ARG fedora_version=44
ARG image_version=44
ARG edition_name="Workstation"
ARG edition_id="workstation"
ARG aurora_shell_uuid=aurora-shell@luminusos.github.io
ARG skip_flatpaks=0
ARG source_url="https://github.com/LuminusOS/images"

LABEL containers.bootc="1" \
      org.opencontainers.image.title="LuminusOS Workstation" \
      org.opencontainers.image.description="Luminus OS bootc image with GNOME desktop" \
      org.opencontainers.image.vendor="LuminusOS" \
      org.opencontainers.image.source="${source_url}" \
      org.opencontainers.image.licenses="Apache-2.0"

# Boot + bootloader + installed desktop packages
RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    bash /scripts/dnf-releasever.sh "${fedora_version}" && \
    dnf clean all && \
    bash /scripts/rpmdb-repair.sh && \
    dnf -y --releasever="${fedora_version}" install \
      kernel dracut \
      bootupd \
      btrfs-progs \
      grub2 grub2-tools grub2-common grub2-pc-modules \
      grub2-efi-x64 grub2-efi-x64-modules grub2-efi-x64-cdboot \
      shim-x64 dosfstools \
      bootc \
      toolbox \
      flatpak \
      mesa-dri-drivers \
      mesa-libGL \
      mesa-libEGL \
      mesa-libgbm \
      fuse-overlayfs \
      cryptsetup \
      plymouth \
      plymouth-plugin-script \
      plymouth-scripts \
      plymouth-system-theme \
      plymouth-theme-spinner \
      ptyxis \
      curl \
      jq \
    && dnf clean all

COPY editions/workstation/files/etc/plymouth/plymouthd.conf /etc/plymouth/plymouthd.conf
COPY editions/workstation/files/etc/dracut.conf.d/10-luminusos-plymouth.conf /etc/dracut.conf.d/10-luminusos-plymouth.conf
COPY editions/workstation/files/usr/share/plymouth/themes/lucent/ /usr/share/plymouth/themes/lucent/

# Rebuild initramfs for the installed image without live ISO modules.
RUN --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    bash /scripts/rebuild-initramfs.sh

# Install the pre-built aurora-shell extension before GNOME Shell is installed.
COPY --from=aurora-extension /out/aurora-shell@luminusos.github.io/ /usr/share/gnome-shell/extensions/aurora-shell@luminusos.github.io/
RUN --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    bash /scripts/aurora-session-modes.sh \
      /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json initial-setup
RUN test -f /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json && \
    test -n "$(find /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json -perm -004 -print -quit)" && \
    test -n "$(find /usr/share/gnome-shell/extensions/${aurora_shell_uuid} -mindepth 1 -maxdepth 1 -print -quit)"

# GNOME desktop environment packages (stable cache — only invalidated by package list changes)
RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    bash /scripts/rpmdb-repair.sh && \
    dnf -y --releasever="${fedora_version}" install \
      --setopt=install_weak_deps=False \
      accountsservice \
      gdm \
      gnome-initial-setup \
      gnome-shell \
      gnome-backgrounds \
      nautilus \
      sushi \
      gnome-software && \
    dnf clean all

# Flatpaks (invalidated only by shared/flatpaks or skip flag)
RUN --mount=type=bind,from=ctx-flatpaks,source=/flatpaks,target=/flatpaks,ro \
    --mount=type=cache,target=/var/cache/dnf \
    --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    if [ "${skip_flatpaks}" = "1" ]; then \
      echo "Skipping Flatpak installation because skip_flatpaks=1"; \
    else \
      bash /scripts/rpmdb-repair.sh && \
      if ! command -v flatpak >/dev/null 2>&1; then \
        dnf -y --releasever="${fedora_version}" install flatpak; \
      fi && \
      curl --retry 3 -Lo /etc/flatpak/remotes.d/flathub.flatpakrepo https://dl.flathub.org/repo/flathub.flatpakrepo && \
      xargs flatpak install -y --noninteractive --no-related < /flatpaks; \
    fi

# Static files + installed workstation configuration (invalidated only by files/ or build.sh changes)
RUN --mount=type=bind,from=ctx-workstation-script,source=/,target=/ctx \
    --mount=type=bind,from=ctx-files,source=/workstation/files,target=/wfiles \
    install -Dm0644 /wfiles/etc/environment.d/electron-wayland.conf /etc/environment.d/electron-wayland.conf && \
    cat /wfiles/etc/hostname > /etc/hostname && \
    chmod 0644 /etc/hostname && \
    install -Dm0644 /wfiles/usr/lib/bootc/kargs.d/10-luminusos-splash.toml /usr/lib/bootc/kargs.d/10-luminusos-splash.toml && \
    install -Dm0644 /wfiles/usr/lib/image-builder/bootc/disk.yaml /usr/lib/image-builder/bootc/disk.yaml && \
    install -Dm0644 /wfiles/usr/share/glib-2.0/schemas/99-install-mode.gschema.override /usr/share/glib-2.0/schemas/99-install-mode.gschema.override && \
    env --chdir=/ctx/workstation ./build.sh

# Dynamic branding stays late so version-only changes reuse package layers.
RUN --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    bash /scripts/os-release-set.sh \
      PRETTY_NAME "Luminus OS ${edition_name} ${image_version}" \
      VARIANT "${edition_name}" \
      VARIANT_ID "${edition_id}"

LABEL org.opencontainers.image.version="${image_version}"

# Compile and validate aurora-shell after GNOME Shell is installed.
RUN test -f /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json && \
    test -n "$(find /usr/share/gnome-shell/extensions/${aurora_shell_uuid} -mindepth 1 -maxdepth 1 -print -quit)" && \
    if [ -d /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/schemas ]; then \
      glib-compile-schemas /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/schemas; \
    fi && \
    GNOME_SHELL_MAJOR="$(gnome-shell --version | awk '{print $3}' | cut -d. -f1)" && \
    jq -e --arg uuid "${aurora_shell_uuid}" --arg major "${GNOME_SHELL_MAJOR}" \
      '.uuid == $uuid and (."shell-version" | index($major)) and (."session-modes" | index("initial-setup"))' \
      /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json

# Final cleanup
RUN dnf clean all && \
    rm -rf /var/cache/dnf /var/cache/libdnf5 /tmp/* /var/log/* /var/tmp/*

RUN command -v bootc && \
    bootc container lint --no-truncate
