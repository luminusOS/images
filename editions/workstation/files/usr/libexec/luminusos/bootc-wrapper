#!/usr/bin/env bash
set -euo pipefail

real_bootc=/usr/libexec/luminusos/bootc-real

if [ ! -x "${real_bootc}" ]; then
  echo "Unable to find real bootc binary: ${real_bootc}" >&2
  exit 127
fi

if [ "$(basename "$0")" = "ostree" ]; then
  exec -a ostree "${real_bootc}" "$@"
fi

install_target_root=""
cleanup_tmpdir=""
containers_conf_dir=""
containers_conf_dropin=""
var_tmp_mounted=0

write_target_grub_configs() {
  local target_root="$1"
  local static_dir=/usr/lib/bootupd/grub2-static
  local boot_dir="${target_root}/boot"
  local efi_mount="${boot_dir}/efi"
  local grub_dir="${boot_dir}/grub2"
  local boot_source=""
  local boot_parent=""
  local boot_uuid=""
  local esp_source=""
  local shim=""
  local grub=""
  local mounted_esp=0

  if [ -z "${target_root}" ] || [ ! -d "${boot_dir}" ]; then
    return 0
  fi

  mkdir -p "${grub_dir}" "${efi_mount}"

  if [ -f "${static_dir}/grub-static-pre.cfg" ]; then
    {
      cat "${static_dir}/grub-static-pre.cfg"
      for cfg in "${static_dir}"/configs.d/*.cfg; do
        [ -f "${cfg}" ] || continue
        printf '\n'
        cat "${cfg}"
      done
    } > "${grub_dir}/grub.cfg"
  else
    cat > "${grub_dir}/grub.cfg" <<'EOF'
set default=0
set timeout_style=menu
set timeout=1
blscfg
EOF
  fi

  if command -v grub2-editenv >/dev/null 2>&1; then
    grub2-editenv "${grub_dir}/grubenv" create >/dev/null 2>&1 || true
  fi

  boot_source="$(findmnt -n -o SOURCE --target "${boot_dir}" 2>/dev/null | head -n 1 || true)"
  boot_uuid="$(findmnt -n -o UUID --target "${boot_dir}" 2>/dev/null | head -n 1 || true)"
  if [ -z "${boot_uuid}" ] && [ -n "${boot_source}" ] && command -v blkid >/dev/null 2>&1; then
    boot_uuid="$(blkid -s UUID -o value "${boot_source}" 2>/dev/null || true)"
  fi

  if ! findmnt --mountpoint "${efi_mount}" >/dev/null 2>&1; then
    if [ -n "${boot_source}" ] && command -v lsblk >/dev/null 2>&1; then
      boot_parent="$(lsblk -npo PKNAME "${boot_source}" 2>/dev/null | head -n 1 || true)"
      if [ -n "${boot_parent}" ]; then
        esp_source="$(lsblk -prno PATH,PKNAME,PARTTYPE 2>/dev/null | awk -v parent="${boot_parent}" 'tolower($2) == tolower(parent) && tolower($3) == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" { print $1; exit }')"
      fi
    fi

    if [ -z "${esp_source}" ] && command -v blkid >/dev/null 2>&1; then
      esp_source="$(blkid -t PARTTYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b -o device 2>/dev/null | head -n 1 || true)"
    fi

    if [ -n "${esp_source}" ] && mount "${esp_source}" "${efi_mount}"; then
      mounted_esp=1
      echo "luminusos bootc-wrapper: mounted ESP ${esp_source} for GRUB config installation" >&2
    fi
  fi

  if findmnt --mountpoint "${efi_mount}" >/dev/null 2>&1; then
    for efi_dir in "${efi_mount}/EFI/fedora" "${efi_mount}/EFI/BOOT"; do
      mkdir -p "${efi_dir}"
      if [ -n "${boot_uuid}" ]; then
        printf 'set BOOT_UUID="%s"\n' "${boot_uuid}" > "${efi_dir}/bootuuid.cfg"
      fi

      cat > "${efi_dir}/grub.cfg" <<'EOF'
if [ -f ${config_directory}/bootuuid.cfg ]; then
  source ${config_directory}/bootuuid.cfg
fi
if [ -n "${BOOT_UUID}" ]; then
  search --fs-uuid "${BOOT_UUID}" --set boot --no-floppy
else
  search --label boot --set boot --no-floppy
fi
if [ -d ($boot)/grub2 ]; then
  set prefix=($boot)/grub2
else
  set prefix=($boot)/boot/grub2
fi
configfile $prefix/grub.cfg
EOF
    done

    shim="$(find \
      "${target_root}/usr/share/shim" \
      "${target_root}/usr/lib/efi" \
      /usr/share/shim \
      /usr/lib/efi \
      -type f -iname 'shimx64.efi' 2>/dev/null | head -n 1 || true)"
    grub="$(find \
      "${target_root}/usr/lib/efi" \
      "${target_root}/usr/lib/grub" \
      /usr/lib/efi \
      /usr/lib/grub \
      -type f -iname 'grubx64.efi' 2>/dev/null | head -n 1 || true)"

    if [ -n "${shim}" ]; then
      install -m 0644 "${shim}" "${efi_mount}/EFI/BOOT/BOOTX64.EFI"
    elif [ -n "${grub}" ]; then
      install -m 0644 "${grub}" "${efi_mount}/EFI/BOOT/BOOTX64.EFI"
    else
      echo "luminusos bootc-wrapper: unable to find shimx64.efi or grubx64.efi for UEFI fallback boot" >&2
    fi

    if [ -n "${grub}" ]; then
      install -m 0644 "${grub}" "${efi_mount}/EFI/BOOT/grubx64.efi"
      install -m 0644 "${grub}" "${efi_mount}/EFI/fedora/grubx64.efi"
    fi
  else
    echo "luminusos bootc-wrapper: target ESP was not mounted; GRUB EFI config was not written" >&2
  fi

  sync "${boot_dir}" "${efi_mount}" || true
  if [ "${mounted_esp}" = "1" ]; then
    umount "${efi_mount}" || umount -l "${efi_mount}" || true
  fi

  echo "luminusos bootc-wrapper: installed target GRUB configs" >&2
}

install_target_bootloader() {
  local target_root="$1"
  local bootupctl=/usr/bin/bootupctl
  local args=()

  [ -n "${target_root}" ] || return 0
  [ -d "${target_root}" ] || return 0

  if [ ! -x "${bootupctl}" ]; then
    echo "luminusos bootc-wrapper: bootupctl not found; relying on fallback EFI files" >&2
    return 0
  fi

  args=(backend install --auto --filesystem "${target_root}")
  if [ "${target_root}" != "/" ]; then
    args+=(--src-root "${target_root}")
  fi
  args+=("${target_root}")

  echo "luminusos bootc-wrapper: installing target bootloader without bootupd static configs" >&2
  if ! "${BASH}" -c 'exec -a bootupctl "$@"' -- "${bootupctl}" "${args[@]}"; then
    echo "luminusos bootc-wrapper: bootupctl install failed; relying on fallback EFI files and GRUB configs" >&2
  fi
}

if [ "${1:-}" = "install" ] && [ "${2:-}" = "to-filesystem" ] && [ "$#" -gt 2 ]; then
  target_root=""
  for arg in "${@:3}"; do
    if [ -d "${arg}" ]; then
      target_root="${arg}"
      break
    fi
  done

  if [ -n "${target_root}" ]; then
    install_target_root="${target_root}"
    cleanup_tmpdir="${target_root}/.bootc-image-copy-tmp"
    mkdir -p "${cleanup_tmpdir}"
    chmod 1777 "${cleanup_tmpdir}" 2>/dev/null || true
    mount --bind "${cleanup_tmpdir}" "${cleanup_tmpdir}"

    mkdir -p /var/tmp
    mount --bind "${cleanup_tmpdir}" /var/tmp
    var_tmp_mounted=1

    containers_conf_dir=$(mktemp -d /run/readymade-bootc-conf.XXXXXX)
    containers_conf="${containers_conf_dir}/containers.conf"
    containers_conf_dropin=/etc/containers/containers.conf.d/99-luminusos-bootc-install-tmp.conf

    escaped_tmpdir="/var/tmp"
    escaped_tmpdir="${escaped_tmpdir//\"/\\\"}"
    printf '[engine]\nimage_copy_tmp_dir = "%s"\n' "${escaped_tmpdir}" > "${containers_conf}"

    mkdir -p /etc/containers/containers.conf.d
    cp "${containers_conf}" "${containers_conf_dropin}"

    echo "luminusos bootc-wrapper: using target-backed /var/tmp for bootc image import" >&2

    export TMPDIR=/var/tmp
    export CONTAINERS_CONF="${containers_conf}"
    export CONTAINERS_CONF_OVERRIDE="${containers_conf}"
  fi
fi

set +e
"${real_bootc}" "$@"
status=$?
set -e

if [ "${status}" = "0" ] && [ -n "${install_target_root}" ]; then
  install_target_bootloader "${install_target_root}"
  write_target_grub_configs "${install_target_root}"
fi

if [ "${var_tmp_mounted}" = "1" ] && mountpoint -q /var/tmp; then
  umount /var/tmp || umount -l /var/tmp || true
fi

if [ -n "${cleanup_tmpdir}" ]; then
  rm -rf "${cleanup_tmpdir:?}/"* 2>/dev/null || true
  if mountpoint -q "${cleanup_tmpdir}"; then
    umount "${cleanup_tmpdir}" || umount -l "${cleanup_tmpdir}" || true
  fi
  rmdir "${cleanup_tmpdir}" 2>/dev/null || true
fi

if [ -n "${containers_conf_dropin}" ]; then
  rm -f "${containers_conf_dropin}" || true
fi

if [ -n "${containers_conf_dir}" ]; then
  rm -rf "${containers_conf_dir}" || true
fi

exit "${status}"
