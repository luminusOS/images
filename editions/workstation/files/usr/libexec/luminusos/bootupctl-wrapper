#!/usr/bin/env bash
set -euo pipefail

real_bootupctl=/usr/libexec/luminusos/bootupctl-real

if [ ! -x "${real_bootupctl}" ]; then
  echo "Unable to find real bootupctl binary: ${real_bootupctl}" >&2
  exit 127
fi

install_static_grub_configs() {
  local static_dir=/usr/lib/bootupd/grub2-static
  local grub_dir=/boot/grub2
  local boot_uuid=""
  local boot_source=""
  local boot_parent=""
  local esp_source=""
  local mounted_esp=0

  if [ ! -d /boot ]; then
    echo "luminusos bootupctl-wrapper: /boot is not available for GRUB config installation" >&2
    return 0
  fi

  mkdir -p "${grub_dir}"

  if [ -f "${static_dir}/grub-static-pre.cfg" ]; then
    {
      cat "${static_dir}/grub-static-pre.cfg"
      for cfg in "${static_dir}"/configs.d/*.cfg; do
        [ -f "${cfg}" ] || continue
        printf '\n'
        cat "${cfg}"
      done
    } > "${grub_dir}/grub.cfg"
  else
    cat > "${grub_dir}/grub.cfg" <<'EOF'
set default=0
set timeout_style=menu
set timeout=1
blscfg
EOF
  fi

  if command -v grub2-editenv >/dev/null 2>&1; then
    grub2-editenv "${grub_dir}/grubenv" create >/dev/null 2>&1 || true
  fi

  boot_source="$(findmnt -n -o SOURCE --target /boot 2>/dev/null | head -n 1 || true)"
  boot_uuid="$(findmnt -n -o UUID --target /boot 2>/dev/null | head -n 1 || true)"
  if [ -z "${boot_uuid}" ]; then
    if [ -n "${boot_source}" ] && command -v blkid >/dev/null 2>&1; then
      boot_uuid="$(blkid -s UUID -o value "${boot_source}" 2>/dev/null || true)"
    fi
  fi

  mkdir -p /boot/efi
  if ! findmnt --mountpoint /boot/efi >/dev/null 2>&1; then
    if [ -n "${boot_source}" ] && command -v lsblk >/dev/null 2>&1; then
      boot_parent="$(lsblk -npo PKNAME "${boot_source}" 2>/dev/null | head -n 1 || true)"
      if [ -n "${boot_parent}" ]; then
        esp_source="$(lsblk -prno PATH,PKNAME,PARTTYPE 2>/dev/null | awk -v parent="${boot_parent}" 'tolower($2) == tolower(parent) && tolower($3) == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" { print $1; exit }')"
      fi
    fi

    if [ -z "${esp_source}" ] && command -v blkid >/dev/null 2>&1; then
      esp_source="$(blkid -t PARTTYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b -o device 2>/dev/null | head -n 1 || true)"
    fi

    if [ -n "${esp_source}" ]; then
      if mount "${esp_source}" /boot/efi; then
        mounted_esp=1
        echo "luminusos bootupctl-wrapper: mounted ESP ${esp_source} for GRUB config installation" >&2
      else
        echo "luminusos bootupctl-wrapper: failed to mount ESP ${esp_source}" >&2
      fi
    else
      echo "luminusos bootupctl-wrapper: could not locate target ESP for GRUB config installation" >&2
    fi
  fi

  for efi_dir in /boot/efi/EFI/fedora /boot/efi/EFI/BOOT; do
    if ! findmnt --mountpoint /boot/efi >/dev/null 2>&1; then
      continue
    fi

    mkdir -p "${efi_dir}"
    if [ -n "${boot_uuid}" ]; then
      printf 'set BOOT_UUID="%s"\n' "${boot_uuid}" > "${efi_dir}/bootuuid.cfg"
    fi

    if [ -f "${static_dir}/grub-static-efi.cfg" ]; then
      install -m 0644 "${static_dir}/grub-static-efi.cfg" "${efi_dir}/grub.cfg"
    else
      cat > "${efi_dir}/grub.cfg" <<'EOF'
if [ -f ${config_directory}/bootuuid.cfg ]; then
  source ${config_directory}/bootuuid.cfg
fi
if [ -n "${BOOT_UUID}" ]; then
  search --fs-uuid "${BOOT_UUID}" --set boot --no-floppy
else
  search --label boot --set boot --no-floppy
fi
set prefix=($boot)/grub2
configfile $prefix/grub.cfg
EOF
    fi
  done

  sync /boot /boot/efi || true
  if [ "${mounted_esp}" = "1" ]; then
    umount /boot/efi || true
  fi

  echo "luminusos bootupctl-wrapper: installed target GRUB configs" >&2
}

is_backend_install=0
filtered_args=()
if [ "${1:-}" = "backend" ] && [ "${2:-}" = "install" ]; then
  is_backend_install=1
  for arg in "$@"; do
    case "${arg}" in
      --with-static-configs|--write-uuid)
        echo "luminusos bootupctl-wrapper: dropping ${arg} for bootc install" >&2
        ;;
      *)
        filtered_args+=("${arg}")
        ;;
    esac
  done
else
  filtered_args=("$@")
fi

# bootupctl hides backend commands unless argv[0] is the canonical name.
if [ "${is_backend_install}" = "1" ]; then
  log_file="$(mktemp /tmp/luminusos-bootupctl.XXXXXX)"
  set +e
  "${BASH}" -c 'exec -a bootupctl "$@"' -- "${real_bootupctl}" "${filtered_args[@]}" > >(tee "${log_file}") 2> >(tee -a "${log_file}" >&2)
  status=$?
  set -e

  install_static_grub_configs

  if [ "${status}" -ne 0 ] && grep -q "Read-only file system" "${log_file}"; then
    echo "luminusos bootupctl-wrapper: ignoring bootupd state write failure on read-only bootc deployment" >&2
    rm -f "${log_file}"
    exit 0
  fi

  rm -f "${log_file}"
  exit "${status}"
fi

exec -a bootupctl "${real_bootupctl}" "${filtered_args[@]}"
