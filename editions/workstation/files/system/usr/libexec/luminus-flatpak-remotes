#!/usr/bin/python3
"""Makes sure the Luminus application remote for this system's update channel exists.

Runs on every boot and never installs applications, never removes or rewrites a remote
that already exists, and never touches user installations. A remote with the same name
but another URL is left alone and reported, so an administrator's choice wins.
"""

import json
import os
from pathlib import Path
import subprocess
import sys

DATA = Path(os.environ.get("LUMINUS_FLATPAK_DATA", "/usr/share/luminus/flatpak"))
OVERRIDE = Path(os.environ.get("LUMINUS_FLATPAK_CHANNEL_FILE", "/etc/luminus/flatpak-channel"))
FILES = {"stable": "luminus-stable.flatpakrepo", "testing": "luminus-testing.flatpakrepo"}


def booted_channel():
    if OVERRIDE.is_file():
        value = OVERRIDE.read_text().strip()
        if value in FILES:
            return value
        print(f"ignoring unknown channel {value!r} in {OVERRIDE}", file=sys.stderr)
    try:
        status = json.loads(subprocess.run(["bootc", "status", "--json"], capture_output=True, text=True,
                                           check=True, timeout=60).stdout)
        reference = status["spec"]["image"]["image"]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return "stable"
    tag = reference.rsplit(":", 1)[-1] if ":" in reference.rsplit("/", 1)[-1] else ""
    return "testing" if tag.startswith("testing") else "stable"


def descriptor(channel):
    values = {}
    for line in (DATA / FILES[channel]).read_text().splitlines():
        if "=" in line:
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip()
    return values["SuggestRemoteName"], values["Url"]


def configured_remotes():
    output = subprocess.run(["flatpak", "remotes", "--system", "--columns=name,url"], capture_output=True,
                            text=True, check=True, timeout=60).stdout
    remotes = {}
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and fields[0].strip():
            remotes[fields[0].strip()] = fields[1].strip().rstrip("/")
    return remotes


def main():
    channel = booted_channel()
    name, url = descriptor(channel)
    try:
        remotes = configured_remotes()
    except (OSError, subprocess.SubprocessError) as error:
        print(f"cannot list Flatpak remotes: {error}", file=sys.stderr)
        return 1
    if name in remotes:
        if remotes[name] != url.rstrip("/"):
            print(f"remote {name} already points at {remotes[name]}; leaving it unchanged")
        return 0
    result = subprocess.run(["flatpak", "remote-add", "--system", "--if-not-exists", name, str(DATA / FILES[channel])],
                            capture_output=True, text=True, timeout=120)
    if result.returncode:
        print(f"cannot add remote {name}: {result.stderr.strip()}", file=sys.stderr)
        return 1
    print(f"added remote {name} for the {channel} channel")
    return 0


if __name__ == "__main__":
    sys.exit(main())
