# Test-only feature: proves the build, publication, discovery and boot path
# without changing hardware behaviour. Its suggestion mirrors the MacBook Pro
# pilot so installer and discovery tests exercise both SMBIOS matches.
FEATURE_ID=dummy
FEATURE_DESCRIPTION='LuminusOS test feature (no hardware changes)'
FEATURE_SUGGEST_ON_FIRMWARE=('smbios-field(sys_vendor = "Apple Inc.")' 'smbios-field(product_name $= "MacBookPro11,[45]")')
FEATURE_PACKAGES=()
FEATURE_RPMS=()
FEATURE_UDEV_TRIGGER=(--subsystem-match=net --sysname-match=lo)
FEATURE_SIZE_BUDGET_MIB=1
FEATURE_EXPANDED_BUDGET_MIB=4
