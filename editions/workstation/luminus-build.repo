[luminus-testing]
name=Luminus OS (testing)
baseurl=https://rpm.luminusos.org/testing/$releasever/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///usr/share/luminus/rpm-keys/luminus-testing.asc

[luminus-stable]
name=Luminus OS (stable)
baseurl=https://rpm.luminusos.org/stable/$releasever/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///usr/share/luminus/rpm-keys/luminus-stable.asc
