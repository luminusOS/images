ARG fedora_version=44
ARG workstation_image=localhost/luminusos-workstation:latest
ARG readymade_ref=main

# ── Context stage: workstation static files ──────────────────────────────
FROM scratch AS ctx-files

COPY editions/workstation/files /workstation/files

# ── ReadyMade from upstream main ──────────────────────────────────────────
FROM quay.io/fedora/fedora-bootc:${fedora_version} AS readymade-main

ARG fedora_version=44
ARG readymade_ref=main

RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=cache,target=/var/cache/cargo/registry \
    --mount=type=cache,target=/var/cache/cargo/git \
    --mount=type=cache,target=/var/cache/cargo-target \
    --mount=type=tmpfs,target=/tmp \
    mkdir -p /etc/dnf/vars /etc/yum/vars && \
    printf '%s\n' "${fedora_version}" > /etc/dnf/vars/releasever && \
    printf '%s\n' "${fedora_version}" > /etc/yum/vars/releasever && \
    dnf -y --releasever="${fedora_version}" install \
      --nogpgcheck \
      --setopt=install_weak_deps=False \
      --repofrompath "terra-bootstrap,https://repos.fyralabs.com/terra${fedora_version}" \
      cargo \
      clang-devel \
      cmake \
      gcc \
      git \
      glibc-all-langpacks \
      gtk4-devel \
      mold \
      openssl-devel \
      pkgconf-pkg-config \
      'pkgconfig(libacl)' \
      'pkgconfig(libhelium-1)' \
      rust && \
    git clone --depth 1 --branch "${readymade_ref}" --recurse-submodules \
      https://github.com/FyraLabs/readymade.git /src/readymade && \
    cd /src/readymade && \
    for export_file in \
      src/backend/export.rs \
      crates/libreadymade/backend/provisioners/disk/repart.rs; do \
      if [ -f "${export_file}" ]; then \
        sed -i 's@if !path.is_file() {@if !path.is_file() || path.extension().and_then(|ext| ext.to_str()) != Some("conf") {@' \
          "${export_file}"; \
      fi; \
    done && \
    for install_file in \
      src/backend/install.rs \
      crates/libreadymade/backend/install.rs; do \
      if [ -f "${install_file}" ]; then \
        sed -i 's@std::fs::create_dir_all("/run/readymade-install")?;@_ = std::fs::remove_dir_all("/run/readymade-install");\n        std::fs::create_dir_all("/run/readymade-install")?;@' \
          "${install_file}"; \
      fi; \
    done && \
    if [ -f crates/libreadymade/backend/provisioners/filesystem/bootc.rs ]; then \
      sed -i 's@let args = &self.args;@let kargs = \&self.kargs;\n        let args = \&self.args;@' \
        crates/libreadymade/backend/provisioners/filesystem/bootc.rs && \
      sed -i 's@args.iter().flat_map(|e| \["--karg", e\])@kargs.iter().flat_map(|e| ["--karg", e])@' \
        crates/libreadymade/backend/provisioners/filesystem/bootc.rs && \
      grep -q 'kargs.iter().flat_map' crates/libreadymade/backend/provisioners/filesystem/bootc.rs; \
    fi && \
    if [ -f crates/libreadymade/backend/mounts.rs ]; then \
      sed -i 's@self\.0\.iter()\.try_for_each(|m| m\.mount(root, passphrase))@{\n            let mut mounts = self.clone();\n            mounts.sort_mounts();\n            mounts.0.iter().try_for_each(|m| m.mount(root, passphrase))\n        }@' \
        crates/libreadymade/backend/mounts.rs && \
      sed -i 's@self\.0\.iter()\.rev()\.try_for_each(|m| m\.umount(root))@{\n            let mut mounts = self.clone();\n            mounts.sort_mounts();\n            mounts.0.iter().rev().try_for_each(|m| m.umount(root))\n        }@' \
        crates/libreadymade/backend/mounts.rs && \
      grep -q 'mounts.sort_mounts();' crates/libreadymade/backend/mounts.rs; \
    fi && \
    if [ -f crates/libreadymade/playbook.rs ]; then \
      sed -i 's@let mut container = Container::new(tempdir.path().to_owned());@let mut container = Container::new(tempdir.path().to_owned());\n    let mut mounts = mounts.clone();\n    mounts.sort_mounts();@' \
        crates/libreadymade/playbook.rs && \
      grep -q 'mounts.sort_mounts();' crates/libreadymade/playbook.rs; \
    fi && \
    for repart_file in \
      crates/libreadymade/backend/install.rs \
      crates/libreadymade/backend/provisioners/disk/repart.rs; do \
      if [ -f "${repart_file}" ]; then \
        sed -i 's@tracing::debug!("systemd-repart finished");@tracing::debug!("systemd-repart finished");\n        let blockdev_str = blockdev.to_str().unwrap();\n        let _ = Command::new("blockdev").args(["--rereadpt", blockdev_str]).status();\n        let _ = Command::new("partx").args(["--update", blockdev_str]).status();\n        let _ = Command::new("udevadm").args(["settle", "--timeout=10"]).status();\n        std::thread::sleep(std::time::Duration::from_millis(500));@' \
          "${repart_file}"; \
      fi; \
    done && \
    if [ -f src/state.rs ]; then \
      sed -i 's@let (receiver, _) = server.accept().expect("cannot accept ipc server");@let Ok((receiver, _)) = server.accept() else {\n            tracing::warn!("IPC server disconnected before subprocess connected");\n            return;\n        };@' \
        src/state.rs && \
      sed -i 's@ipc_thread.join().expect("cannot join ipc thread");@if let Err(err) = ipc_thread.join() {\n        tracing::warn!(?err, "IPC progress thread panicked");\n    }@' \
        src/state.rs && \
      grep -q 'IPC server disconnected before subprocess connected' src/state.rs; \
    fi && \
    HOME=/tmp CARGO_HOME=/var/cache/cargo CARGO_TARGET_DIR=/var/cache/cargo-target cargo build --release --locked && \
    install -Dm755 /var/cache/cargo-target/release/readymade /out/usr/bin/readymade && \
    bash scripts/install.sh /out && \
    mkdir -p /out/usr/lib64 && \
    cp -a /usr/lib64/libhelium-1.so* /out/usr/lib64/ && \
    cp -a /usr/lib64/libgee-0.8.so* /out/usr/lib64/ && \
    dnf clean all

# ── Workstation live ISO root ────────────────────────────────────────────
FROM ${workstation_image}

ARG fedora_version=44
ARG image_version=44
ARG workstation_image=localhost/luminusos-workstation:latest
ARG workstation_target_image=ghcr.io/luminusos/luminusos-workstation:44
ARG aurora_shell_uuid=aurora-shell@luminusos.github.io
ARG source_url="https://github.com/LuminusOS/images"

LABEL containers.bootc="1" \
      org.opencontainers.image.title="LuminusOS Workstation Installer" \
      org.opencontainers.image.description="Luminus OS workstation live installer ISO root" \
      org.opencontainers.image.vendor="LuminusOS" \
      org.opencontainers.image.source="${source_url}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${image_version}"

RUN --mount=type=cache,target=/var/cache/dnf \
    rm -f /var/lib/rpm/.rpm.lock /usr/lib/sysimage/rpm/.rpm.lock || true && \
    if ! rpm --rebuilddb; then \
      rebuilt_db="$(find /usr/share -maxdepth 1 -type d -name 'rpmrebuilddb.*' | sort -V | tail -n 1)" && \
      [ -n "${rebuilt_db}" ] && \
      rm -rf /usr/share/rpm && \
      mv "${rebuilt_db}" /usr/share/rpm; \
    fi && \
    rpm -qa >/dev/null && \
    dnf -y --releasever="${fedora_version}" install \
      dracut-live \
      squashfs-tools \
      xorriso \
      isomd5sum \
      livesys-scripts \
      podman \
      fuse-overlayfs && \
    dnf clean all

COPY --from=readymade-main /out/ /

RUN --mount=type=bind,from=ctx-files,source=/workstation/files,target=/wfiles \
    install -Dm0644 /wfiles/etc/luminusos/system-mode /etc/luminusos/system-mode && \
    install -Dm0644 /wfiles/etc/readymade.toml /etc/readymade.toml && \
    install -Dm0644 /wfiles/etc/polkit-1/rules.d/49-luminusos-readymade.rules /etc/polkit-1/rules.d/49-luminusos-readymade.rules && \
    install -Dm0644 /wfiles/etc/dconf/db/local.d/00-iso-live-mode /etc/dconf/db/local.d/00-iso-live-mode && \
    install -Dm0644 /wfiles/etc/dconf/profile/user /etc/dconf/profile/user && \
    install -Dm0644 /wfiles/usr/lib/image-builder/bootc/iso.yaml /usr/lib/image-builder/bootc/iso.yaml && \
    install -Dm0644 /wfiles/usr/lib/systemd/user/luminusos-readymade.service /usr/lib/systemd/user/luminusos-readymade.service && \
    install -Dm0644 /wfiles/usr/lib/systemd/user/gnome-session@live-installer.target.d/live-installer.session.conf /usr/lib/systemd/user/gnome-session@live-installer.target.d/live-installer.session.conf && \
    mkdir -p /usr/lib/systemd/user/gnome-session@live-installer.target.wants && \
    ln -sf ../luminusos-readymade.service /usr/lib/systemd/user/gnome-session@live-installer.target.wants/luminusos-readymade.service && \
    install -Dm0644 /wfiles/usr/lib/tmpfiles.d/luminusos-readymade.conf /usr/lib/tmpfiles.d/luminusos-readymade.conf && \
    install -Dm0755 /wfiles/usr/libexec/luminusos/bootc-wrapper /usr/libexec/luminusos/bootc-wrapper && \
    install -Dm0755 /wfiles/usr/libexec/luminusos/readymade-wrapper /usr/libexec/luminusos/readymade-wrapper && \
    install -Dm0644 /wfiles/usr/share/wayland-sessions/live-installer.desktop /usr/share/wayland-sessions/live-installer.desktop && \
    install -Dm0644 /wfiles/usr/share/gnome-session/sessions/live-installer.session /usr/share/gnome-session/sessions/live-installer.session && \
    install -Dm0644 /wfiles/usr/share/gnome-shell/modes/live-installer.json /usr/share/gnome-shell/modes/live-installer.json && \
    mkdir -p /usr/share/readymade && \
    cp -arf /wfiles/usr/share/readymade/. /usr/share/readymade/

RUN mkdir -p /boot/efi /boot/loader/entries && \
    printf 'live\n' > /etc/luminusos/system-mode && \
    rm -f /usr/share/applications/liveinst.desktop && \
    if [ -f /usr/share/applications/com.fyralabs.Readymade.desktop ]; then \
      mkdir -p /etc/xdg/autostart && \
      sed -i '/^NoDisplay=/d' /usr/share/applications/com.fyralabs.Readymade.desktop && \
      sed -i '/^Hidden=/d' /usr/share/applications/com.fyralabs.Readymade.desktop && \
      sed -i 's|^Exec=.*|Exec=/usr/libexec/luminusos/readymade-wrapper|' /usr/share/applications/com.fyralabs.Readymade.desktop && \
      cp -f /usr/share/applications/com.fyralabs.Readymade.desktop /etc/xdg/autostart/com.fyralabs.Readymade.desktop && \
      sed -i '/^NoDisplay=/d' /usr/share/applications/com.fyralabs.Readymade.desktop && \
      sed -i '/^Hidden=/d' /usr/share/applications/com.fyralabs.Readymade.desktop && \
      printf '\nNoDisplay=true\nHidden=true\n' >> /usr/share/applications/com.fyralabs.Readymade.desktop; \
    fi && \
    tmp="$(mktemp)" && \
    jq '.["session-modes"] = (((.["session-modes"] // ["user"]) + ["live-installer", "initial-setup"]) | unique)' \
      /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json > "${tmp}" && \
    install -m 0644 "${tmp}" /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json && \
    rm -f "${tmp}" && \
    if [ -d /usr/share/glib-2.0/schemas ]; then \
      glib-compile-schemas /usr/share/glib-2.0/schemas; \
    fi && \
    if command -v dconf >/dev/null 2>&1; then \
      dconf update; \
    fi && \
    systemctl mask bootloader-update.service && \
    useradd -m -G wheel liveuser || true && \
    passwd -d liveuser && \
    mkdir -p /etc/gdm && \
    printf '[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=liveuser\nDefaultSession=live-installer.desktop\n' > /etc/gdm/custom.conf && \
    mkdir -p /var/lib/AccountsService/users && \
    printf '[User]\nSession=live-installer\nXSession=live-installer\nSystemAccount=false\n' > /var/lib/AccountsService/users/liveuser

RUN sed -i \
      "s|^bootc_imgref = .*|bootc_imgref = \"containers-storage:${workstation_image}\"|" \
      /etc/readymade.toml && \
    sed -i \
      "s|^bootc_target_imgref = .*|bootc_target_imgref = \"${workstation_target_image}\"|" \
      /etc/readymade.toml && \
    grep -q '^copy_mode = "bootc"$' /etc/readymade.toml

# Rebuild initramfs for live ISO boot.
RUN KVER=$(kernel-install list --json pretty 2>/dev/null \
      | jq -r '.[] | select(.has_kernel == true) | .version' \
      | head -n1) && \
    [ -z "${KVER}" ] && KVER=$(ls -1 /lib/modules | tail -n1) || true && \
    plymouth-set-default-theme lucent && \
    DRACUT_NO_XATTR=1 dracut -v -f --zstd --reproducible --no-hostonly \
      --add "plymouth dmsquash-live dmsquash-live-autooverlay" \
      "/usr/lib/modules/${KVER}/initramfs.img" "${KVER}"

# Copy EFI files for image-builder and provide a removable-media fallback path.
RUN mkdir -p /boot/efi && \
    cp -av /usr/lib/efi/*/*/EFI /boot/efi/ && \
    mkdir -p /boot/efi/EFI/BOOT /boot/efi/EFI/fedora && \
    shim="$(find /usr/share/shim /usr/lib/efi -type f -iname 'shimx64.efi' 2>/dev/null | head -n 1 || true)" && \
    grub="$(find /usr/lib/efi /usr/lib/grub -type f -iname 'grubx64.efi' 2>/dev/null | head -n 1 || true)" && \
    if [ -n "${shim}" ]; then \
      install -m 0644 "${shim}" /boot/efi/EFI/BOOT/BOOTX64.EFI; \
    elif [ -n "${grub}" ]; then \
      install -m 0644 "${grub}" /boot/efi/EFI/BOOT/BOOTX64.EFI; \
    else \
      echo "Unable to find shimx64.efi or grubx64.efi for UEFI fallback boot"; \
      exit 1; \
    fi && \
    if [ -n "${grub}" ]; then \
      install -m 0644 "${grub}" /boot/efi/EFI/BOOT/grubx64.efi; \
      install -m 0644 "${grub}" /boot/efi/EFI/fedora/grubx64.efi; \
    fi && \
    printf '%s\n' \
      'if [ -f ${config_directory}/bootuuid.cfg ]; then' \
      '  source ${config_directory}/bootuuid.cfg' \
      'fi' \
      'if [ -n "${BOOT_UUID}" ]; then' \
      '  search --fs-uuid "${BOOT_UUID}" --set boot --no-floppy' \
      'else' \
      '  search --label boot --set boot --no-floppy' \
      'fi' \
      'if [ -d ($boot)/grub2 ]; then' \
      '  set prefix=($boot)/grub2' \
      'else' \
      '  set prefix=($boot)/boot/grub2' \
      'fi' \
      'configfile $prefix/grub.cfg' \
      > /boot/efi/EFI/fedora/grub.cfg && \
    install -m 0644 /boot/efi/EFI/fedora/grub.cfg /boot/efi/EFI/BOOT/grub.cfg

RUN install -D -m 0755 /usr/bin/bootc /usr/libexec/luminusos/bootc-real && \
    install -m 0755 /usr/libexec/luminusos/bootc-wrapper /usr/bin/bootc

RUN command -v readymade && \
    ldd /usr/bin/readymade | tee /tmp/readymade-ldd && \
    ! grep -q 'not found' /tmp/readymade-ldd && \
    command -v bootc && \
    command -v bootupctl && \
    test -x /usr/libexec/luminusos/bootc-real && \
    test -f /etc/readymade.toml && \
    test -f /usr/share/wayland-sessions/live-installer.desktop && \
    test -L /usr/lib/systemd/user/gnome-session@live-installer.target.wants/luminusos-readymade.service && \
    test -f /usr/lib/image-builder/bootc/iso.yaml && \
    GNOME_SHELL_MAJOR="$(gnome-shell --version | awk '{print $3}' | cut -d. -f1)" && \
    jq -e --arg uuid "${aurora_shell_uuid}" --arg major "${GNOME_SHELL_MAJOR}" \
      '.uuid == $uuid and (."shell-version" | index($major)) and (."session-modes" | index("live-installer")) and (."session-modes" | index("initial-setup"))' \
      /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json && \
    /usr/libexec/luminusos/bootc-real container lint --no-truncate
