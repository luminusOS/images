ARG fedora_version=44
ARG workstation_image=localhost/luminusos-workstation:latest

FROM scratch AS ctx-scripts

COPY shared/scripts /scripts

FROM ${workstation_image} AS live

ARG fedora_version=44
ARG image_version=44
ARG sirius_version=1.0.3
ARG workstation_image=localhost/luminusos-workstation:latest
ARG workstation_target_image=ghcr.io/luminusos/luminusos-workstation:44
ARG aurora_shell_uuid=aurora-shell@luminusos.github.io
ARG source_url="https://github.com/LuminusOS/images"

RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    bash /scripts/rpmdb-repair.sh && \
    dnf -y --releasever="${fedora_version}" install \
      bubblewrap \
      dracut-live \
      fuse-overlayfs \
      glibc-all-langpacks \
      gtk4 \
      isomd5sum \
      libadwaita \
      livesys-scripts \
      podman \
      polkit \
      squashfs-tools \
      xorriso \
      "https://github.com/luminusOS/sirius/releases/download/v${sirius_version}/sirius-installer-${sirius_version}-1.x86_64.rpm" && \
    dnf clean all && \
    # The Sirius RPM ships generic repart definitions (10-esp.conf,
    # 20-root.conf) that would mix with the LuminusOS 10-root/20-boot/30-esp
    # scheme and hand systemd-repart five partitions. Drop everything the RPM
    # installed there; the LuminusOS templates are installed below.
    rm -f /usr/share/sirius/repart.d/*.conf

# Static installer files are copied declaratively from files/. The following
# RUN blocks only perform transformations or runtime image configuration.
COPY editions/workstation/files/etc/dconf/db/local.d/00-iso-live-mode /etc/dconf/db/local.d/00-iso-live-mode
COPY editions/workstation/files/etc/dconf/profile/user /etc/dconf/profile/user
COPY editions/workstation/files/etc/gdm/custom.conf /etc/gdm/custom.conf
COPY editions/workstation/files/etc/sirius/distro.toml /etc/sirius/distro.toml
COPY editions/workstation/files/etc/sirius/hostname /etc/hostname
COPY editions/workstation/files/etc/sirius/sirius.toml /etc/sirius/sirius.toml
COPY editions/workstation/files/usr/lib/image-builder/bootc/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY editions/workstation/files/usr/lib/systemd/user/gnome-session@live-installer.target.d/live-installer.sirius.conf /usr/lib/systemd/user/gnome-session@live-installer.target.d/live-installer.session.conf
COPY editions/workstation/files/usr/lib/systemd/user/luminusos-sirius.service /usr/lib/systemd/user/luminusos-sirius.service
COPY editions/workstation/files/usr/share/gnome-session/sessions/live-installer.session /usr/share/gnome-session/sessions/live-installer.session
COPY editions/workstation/files/usr/share/gnome-shell/modes/live-installer.json /usr/share/gnome-shell/modes/live-installer.json
COPY editions/workstation/files/usr/share/icons/hicolor/scalable/actions/ /usr/share/icons/hicolor/scalable/actions/
COPY editions/workstation/files/usr/share/polkit-1/rules.d/50-sirius-live.rules /usr/share/polkit-1/rules.d/50-sirius-live.rules
COPY editions/workstation/files/usr/share/sirius/logo.png /usr/share/sirius/logo.png
COPY editions/workstation/files/usr/share/sirius/welcome-banner.png /usr/share/sirius/welcome-banner.png
COPY editions/workstation/files/usr/share/sirius/repart.d/ /usr/share/sirius/repart.d/
COPY editions/workstation/files/usr/share/wayland-sessions/live-installer.desktop /usr/share/wayland-sessions/live-installer.desktop
COPY editions/workstation/files/var/lib/AccountsService/users/liveuser /var/lib/AccountsService/users/liveuser
COPY editions/workstation/files/boot/efi/EFI/fedora/grub.cfg /boot/efi/EFI/fedora/grub.cfg
COPY editions/workstation/files/boot/efi/EFI/fedora/grub.cfg /boot/efi/EFI/BOOT/grub.cfg

RUN sed -i \
      -e "s|@WORKSTATION_TARGET_IMAGE@|${workstation_target_image}|g" \
      /etc/sirius/distro.toml && \
    grep -q 'image = "oci:/usr/lib/luminusos/payload.oci:latest"' /etc/sirius/distro.toml && \
    grep -q 'target_imgref = "'"${workstation_target_image}"'"' /etc/sirius/distro.toml && \
    (gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true)

RUN --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    mkdir -p /boot/efi /boot/loader/entries && \
    rm -f /usr/share/applications/liveinst.desktop && \
    mkdir -p /usr/lib/systemd/user/gnome-session@live-installer.target.d \
      /usr/lib/systemd/user/gnome-session@live-installer.target.wants && \
    ln -sf ../luminusos-sirius.service /usr/lib/systemd/user/gnome-session@live-installer.target.wants/luminusos-sirius.service && \
    bash /scripts/aurora-session-modes.sh \
      /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json live-installer initial-setup && \
    if [ -d /usr/share/glib-2.0/schemas ]; then \
      glib-compile-schemas /usr/share/glib-2.0/schemas; \
    fi && \
    if command -v dconf >/dev/null 2>&1; then \
      dconf update; \
    fi && \
    systemctl mask bootloader-update.service && \
    if ! id -u liveuser >/dev/null 2>&1; then \
      useradd -m -G wheel liveuser; \
    fi && \
    passwd -d liveuser

RUN --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    bash /scripts/rebuild-initramfs.sh --add "plymouth dmsquash-live"

# Copy EFI files for image-builder and provide a removable-media fallback path.
RUN mkdir -p /boot/efi && \
    cp -av /usr/lib/efi/*/*/EFI /boot/efi/ && \
    mkdir -p /boot/efi/EFI/BOOT /boot/efi/EFI/fedora && \
    shim="$(find /usr/share/shim /usr/lib/efi -type f -iname 'shimx64.efi' 2>/dev/null | head -n 1 || true)" && \
    grub="$(find /usr/lib/efi /usr/lib/grub -type f -iname 'grubx64.efi' 2>/dev/null | head -n 1 || true)" && \
    if [ -n "${shim}" ]; then \
      install -m 0644 "${shim}" /boot/efi/EFI/BOOT/BOOTX64.EFI; \
    elif [ -n "${grub}" ]; then \
      install -m 0644 "${grub}" /boot/efi/EFI/BOOT/BOOTX64.EFI; \
    else \
      echo "Unable to find shimx64.efi or grubx64.efi for UEFI fallback boot"; \
      exit 1; \
    fi && \
    if [ -n "${grub}" ]; then \
      install -m 0644 "${grub}" /boot/efi/EFI/BOOT/grubx64.efi; \
      install -m 0644 "${grub}" /boot/efi/EFI/fedora/grubx64.efi; \
    fi

# Generated into the build context by the caller:
#   skopeo copy <payload-image> oci:.test/payload.oci:latest
COPY .test/payload.oci /usr/lib/luminusos/payload.oci

# osbuild deploys the ISO live root without applying OCI whiteout semantics,
# so the merged filesystem is copied into a single whiteout-free layer.
FROM scratch

COPY --from=live / /

ARG aurora_shell_uuid=aurora-shell@luminusos.github.io
ARG image_version=44
ARG sirius_version=1.0.3
ARG source_url="https://github.com/LuminusOS/images"

LABEL containers.bootc="1" \
      org.opencontainers.image.title="LuminusOS Workstation Sirius Installer" \
      org.opencontainers.image.description="Luminus OS workstation live installer ISO root with Sirius" \
      org.opencontainers.image.vendor="LuminusOS" \
      org.opencontainers.image.source="${source_url}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${image_version}"

RUN command -v sirius && \
    rpm -q sirius-installer && \
    test "$(rpm -q --queryformat '%{VERSION}' sirius-installer)" = "${sirius_version}" && \
    ldd /usr/bin/sirius | tee /tmp/sirius-ldd && \
    ! grep -q 'not found' /tmp/sirius-ldd && \
    command -v bootc && \
    command -v bootupctl && \
    # Sirius 1.0 runtime: bwrap sandboxes the glycin SVG decoder, the full
    # langpack keeps the language page from listing only the C locales, and
    # the RPM ships the timezone map artwork plus the welcome banner.
    command -v bwrap && \
    command -v ptyxis && \
    locale -a | grep -qx 'pt_BR.utf8' && \
    test -f /usr/share/sirius/timezone-map.svg && \
    test -f /usr/share/sirius/timezone-pin.png && \
    test -f /usr/share/sirius/welcome-banner.png && \
    test -f /etc/gnome-initial-setup/vendor.conf && \
    grep -Eq '^skip=software$' /etc/gnome-initial-setup/vendor.conf && \
    grep -Eq '^existing_user_only=language$' /etc/gnome-initial-setup/vendor.conf && \
    ! grep -Eiq '^[[:space:]]*(skip|existing_user_only)[[:space:]]*=.*keyboard' \
      /etc/gnome-initial-setup/vendor.conf && \
    # The squashed single layer must not contain materialized OCI whiteouts.
    test -z "$(find / -xdev -name '.wh.*' -print -quit)" && \
    # The installer payload is embedded as an OCI layout tagged "latest".
    test -f /usr/lib/luminusos/payload.oci/index.json && \
    jq -e '.manifests[0].annotations."org.opencontainers.image.ref.name" == "latest"' \
      /usr/lib/luminusos/payload.oci/index.json && \
    test -f /etc/sirius/distro.toml && \
    test -f /etc/sirius/sirius.toml && \
    grep -Eq '^command = "ptyxis"$' /etc/sirius/sirius.toml && \
    grep -Eq '^show_button = true$' /etc/sirius/sirius.toml && \
    # Exactly the three LuminusOS repart definitions: the RPM's generic
    # 10-esp/20-root pair must be gone or systemd-repart would see five.
    test ! -e /usr/share/sirius/repart.d/10-esp.conf && \
    test ! -e /usr/share/sirius/repart.d/20-root.conf && \
    test -f /usr/share/sirius/repart.d/10-root.conf && \
    test -f /usr/share/sirius/repart.d/20-boot.conf && \
    test -f /usr/share/sirius/repart.d/30-esp.conf && \
    test -f /usr/share/polkit-1/actions/io.sirius.Installer.policy && \
    test -f /usr/share/polkit-1/rules.d/50-sirius-live.rules && \
    test -f /usr/share/sirius/logo.png && \
    test -f /usr/share/icons/hicolor/scalable/actions/explore-symbolic.svg && \
    test -f /usr/share/wayland-sessions/live-installer.desktop && \
    test -L /usr/lib/systemd/user/gnome-session@live-installer.target.wants/luminusos-sirius.service && \
    test -f /usr/lib/image-builder/bootc/iso.yaml && \
    GNOME_SHELL_MAJOR="$(gnome-shell --version | awk '{print $3}' | cut -d. -f1)" && \
    jq -e --arg uuid "${aurora_shell_uuid}" --arg major "${GNOME_SHELL_MAJOR}" \
      '.uuid == $uuid and (."shell-version" | index($major)) and (."session-modes" | index("live-installer")) and (."session-modes" | index("initial-setup"))' \
      /usr/share/gnome-shell/extensions/${aurora_shell_uuid}/metadata.json && \
    bootc container lint --no-truncate
