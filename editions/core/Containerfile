ARG base=quay.io/fedora/fedora-bootc:45

FROM scratch AS ctx-scripts

COPY shared/scripts /scripts

FROM ${base} AS python-tools
ARG fedora_version
RUN dnf -y --releasever="${fedora_version}" install python3 && dnf clean all

FROM ${base}

COPY shared/trust/ /

ARG fedora_version
ARG distro_version
ARG distro_name="LuminusOS"
ARG distro_pretty_name="Luminus OS"
ARG source_url="https://github.com/LuminusOS/images"

LABEL containers.bootc="1" \
      org.opencontainers.image.title="LuminusOS Core" \
      org.opencontainers.image.description="Luminus OS base bootc image" \
      org.opencontainers.image.vendor="LuminusOS" \
      org.opencontainers.image.source="${source_url}" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    --mount=type=bind,from=python-tools,source=/usr,target=/opt/python,ro \
    env PYTHONHOME=/opt/python LD_LIBRARY_PATH=/opt/python/lib64 /opt/python/bin/python3 /scripts/dnf-releasever.py "${fedora_version}"

RUN --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    --mount=type=bind,from=python-tools,source=/usr,target=/opt/python,ro \
    env PYTHONHOME=/opt/python LD_LIBRARY_PATH=/opt/python/lib64 /opt/python/bin/python3 /scripts/rpmdb-repair.py && \
    dnf -y --releasever="${fedora_version}" install firewalld && \
    dnf clean all && \
    rm -rf /var/cache/dnf /var/cache/libdnf5 /tmp/* /var/log/* /var/tmp/*

# Dynamic branding stays late so version-only changes reuse package layers.
RUN --mount=type=bind,from=ctx-scripts,source=/scripts,target=/scripts \
    --mount=type=bind,from=python-tools,source=/usr,target=/opt/python,ro \
    env PYTHONHOME=/opt/python LD_LIBRARY_PATH=/opt/python/lib64 /opt/python/bin/python3 /scripts/os-release-set.py \
      NAME "${distro_name}" \
      PRETTY_NAME "${distro_pretty_name} ${distro_version}" \
      VERSION "${distro_version}" \
      VERSION_ID "${fedora_version}" \
      BUILD_ID "${distro_version}" \
      IMAGE_ID "luminusos" \
      IMAGE_VERSION "${distro_version}"

LABEL org.opencontainers.image.version="${distro_version}"

RUN command -v bootc && \
    systemctl is-enabled firewalld.service && \
    bootc container lint --no-truncate
