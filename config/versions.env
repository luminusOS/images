# Defaults shared by local builds and GitHub Actions. User-provided LOS_*,
# SIRIUS_* values still take precedence.
DEFAULT_FEDORA_VERSION=45
FEDORA_BOOTC_DIGEST=sha256:d70fb477a35612f651fcfa397f41e2945514374d3fdaaa64b0e75a3ca1da2bbc
# Sirius is installed from the Luminus RPM repository (https://rpm.luminusos.org), which the
# image already has configured and whose packages and metadata are signed. A release
# candidate such as 1.0.5-rc.2 is a testing-channel package whose RPM version is 1.0.5~rc.2;
# a final version comes from the stable channel.
SIRIUS_VERSION=1.0.5
SIRIUS_RPM_VERSION=1.0.5
# Channel installed systems update from (testing or stable).
UPDATE_CHANNEL=testing
