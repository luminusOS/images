# Defaults shared by local builds and GitHub Actions. User-provided LOS_*,
# AURORA_SHELL_* and SIRIUS_* values still take precedence.
DEFAULT_FEDORA_VERSION=45
FEDORA_BOOTC_DIGEST=sha256:c3cccbe8c7263cfc610ca9697cf4e0a34bb5b590b394f413f1c159ef63fb15ac
AURORA_SHELL_VERSION=v51
AURORA_SHELL_SHA256=cdf0b35c5c751c64d79372d50af1398b96c006b8c5199a28d76f407cd88b7bc0
# elastic-swap swap daemon. The image build downloads
#   https://github.com/luminusOS/elastic-swap/releases/download/v<VERSION>/elastic-swap-<VERSION>-1.fc<FEDORA>.x86_64.rpm
# so that release and asset must exist before this is merged, and the digest is
# that exact uploaded file's (a rebuilt RPM differs). Update both with the version.
ELASTIC_SWAP_VERSION=0.2.4
ELASTIC_SWAP_SHA256=b35783cc4b444c7fc398d995b43cd7e8e72ba74ee29506fc92ea5f8d88d1be35
# Sirius comes from the Luminus RPM repository (https://rpm.luminusos.org) as the
# exact package published for this version. A release candidate such as 1.0.5-rc.2 is
# a testing-channel package whose RPM version is 1.0.5~rc.2; a final version comes from
# the stable channel. SIRIUS_SHA256 is the digest of the signed x86_64 package file.
SIRIUS_VERSION=1.0.5-rc.2
SIRIUS_RPM_VERSION=1.0.5~rc.2
# Channel installed systems update from (testing or stable).
UPDATE_CHANNEL=testing
SIRIUS_SHA256=c1b56c7160527802c4b086a0a6185b47d2c2df9635e88d399e63afc20ea0959b
